flowchart TD
    %% Generated by scripts/render_pipeline_diagram.py.
    %% Same nodes and data relationships as the approved PNG/SVG.
    %% Stage numbers show execution order; branches show data flow.
    zoneSource["Taxi Zone Lookup<br/>CSV จาก NYC TLC<br/>รหัสพื้นที่ ชื่อพื้นที่ และ Borough"]:::source
    configSource["Pipeline config (JSON)<br/>config/pipeline.json<br/>ช่วงเดือน แหล่งข้อมูล และโฟลเดอร์"]:::source
    tripSource["Trip Records<br/>Parquet จาก NYC TLC<br/>24 ไฟล์ จาก Taxi 4 ประเภท"]:::source
    prepare("01 · PREPARE<br/>อ่าน config และช่วงเดือน<br/>เตรียมรายการไฟล์ของรอบรัน"):::process
    lookup("02 · LOOKUP<br/>รับและตรวจตารางพื้นที่ CSV<br/>ยืนยัน 265 รหัสไม่ซ้ำ เก็บ lookup ในหน่วยความจำ"):::process
    trips("03 · TRIPS<br/>ตรวจ SHA-256, schema และกฎเวลา<br/>สรุปรายวัน หรือใช้ cache ที่ตรงกัน"):::process
    curate("04 · CURATED<br/>LEFT JOIN ยอดรายวันกับพื้นที่รับผู้โดยสาร<br/>คงเที่ยวที่ไม่ทราบพื้นที่เป็น Unknown"):::process
    curatedStore[("Curated Parquet<br/>daily_zone_counts.parquet  •  trip_count<br/>วัน × ประเภทรถ × พื้นที่ × ไฟล์ต้นทาง")]:::data
    quality("05 · QUALITY<br/>ตรวจคุณภาพ 10 เงื่อนไข<br/>เทียบยอด curated กับ audit"):::quality
    analysis("06 · ANALYSIS<br/>รวมยอดและจัดอันดับ Taxi<br/>สร้างตารางและกราฟ"):::process
    publish("07 · PUBLISH<br/>บันทึก SUCCESS และ content hash<br/>อัปเดต latest.json ในเครื่อง"):::process
    failed("FAILED<br/>บันทึกข้อผิดพลาดใน log<br/>คงผลสำเร็จของรอบก่อน"):::failed
    analysisStore[("Analysis results<br/>อันดับ / รายเดือน / พื้นที่<br/>CSV และกราฟ")]:::data
    runEvidence["Run logs & evidence<br/>run.json / pipeline.log<br/>latest.json ชี้รอบสำเร็จ"]:::evidence
    configSource --> prepare
    zoneSource -->|"ตารางพื้นที่"| lookup
    tripSource -->|"ข้อมูลเที่ยวรถ"| trips
    prepare -->|"URL พื้นที่"| lookup
    prepare -->|"รายการไฟล์"| trips
    lookup -->|"lookup ผ่านตรวจ"| curate
    trips -->|"ยอดรายวัน"| curate
    curate -->|"ข้อมูลหลังเชื่อมพื้นที่"| curatedStore
    curatedStore -->|"curated"| quality
    trips -->|"audit: raw / valid / rejected"| quality
    quality -->|"PASS"| analysis
    analysis -->|"รายงาน"| publish
    quality -.->|"FAIL"| failed
    analysis -->|"ตาราง / กราฟ"| analysisStore
    publish -->|"สถานะรัน"| runEvidence
