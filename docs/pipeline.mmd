flowchart TD
    %% Generated by scripts/render_pipeline_diagram.py.
    %% Canonical graph for the two README views. D2 and D3 are shared data stores.
    %% Numbers match log stages; arrows show data dependencies, not parallel execution.
    configSource["การตั้งค่า pipeline (JSON)<br/>config/pipeline.json: ช่วงเดือน แหล่งข้อมูล และโฟลเดอร์"]:::source
    prepare("1. เตรียมรายการข้อมูล<br/>อ่าน config และช่วงเดือน<br/>ระบุไฟล์สำหรับขั้น 2 และ 3"):::process
    zoneSource["Taxi Zone Lookup<br/>CSV จาก NYC TLC<br/>รหัสและชื่อพื้นที่"]:::source
    tripSource["Trip Records<br/>Parquet จาก NYC TLC<br/>24 ไฟล์ จาก Taxi 4 ประเภท"]:::source
    lookup("2. ตรวจตารางพื้นที่<br/>ตรวจคอลัมน์และรหัสพื้นที่<br/>LocationID ต้องไม่ซ้ำ"):::process
    trips("3. ตรวจและสรุปเที่ยวรถ<br/>ตรวจ SHA-256 และกฎเวลา<br/>สรุปรายวัน หรือใช้ cache"):::process
    zonesStore[("D1 พื้นที่ที่ผ่านตรวจ<br/>265 รหัสในหน่วยความจำ<br/>Zone และ Borough")]:::store
    aggregateStore[("D2 ผลสรุปและ audit<br/>data/cache/<br/>raw / valid / rejected")]:::store
    curate("4. เชื่อมข้อมูลพื้นที่<br/>LEFT JOIN ด้วย pickup_location_id<br/>เก็บพื้นที่ที่ไม่ทราบเป็น Unknown"):::process
    curatedStore[("D3 ชุดข้อมูลพร้อมวิเคราะห์ (Curated)<br/>daily_zone_counts.parquet<br/>วัน × ประเภท Taxi × พื้นที่รับผู้โดยสาร × ไฟล์ต้นทาง<br/>จำนวนเที่ยวของแต่ละกลุ่มอยู่ใน trip_count")]:::store
    quality("5. ตรวจคุณภาพข้อมูล<br/>เทียบยอด curated กับ audit<br/>ต้องผ่านครบ 10 เงื่อนไข"):::quality
    analysis("6. วิเคราะห์ผล<br/>รวม trip_count เพื่อจัดอันดับ<br/>สร้างตารางรายเดือนและพื้นที่"):::process
    publish("7. บันทึกผลสำเร็จ<br/>คำนวณ hash และบันทึก SUCCESS<br/>อัปเดต latest.json หลังสำเร็จ"):::process
    failed["FAILED<br/>บันทึกข้อผิดพลาดใน log<br/>คงผลสำเร็จเดิม"]:::failed
    resultStore[("D4 ผลวิเคราะห์<br/>ตาราง CSV<br/>กราฟและตัวอย่าง")]:::store
    successStore[("D5 สถานะรัน<br/>run.json<br/>latest.json")]:::store
    configSource --> prepare
    prepare -->|"URL พื้นที่"| lookup
    prepare -->|"รายการไฟล์"| trips
    zoneSource -->|"CSV"| lookup
    tripSource -->|"Parquet"| trips
    lookup -->|"ผ่านตรวจ"| zonesStore
    trips -->|"บันทึก"| aggregateStore
    aggregateStore -->|"ใช้ซ้ำ"| trips
    zonesStore -->|"ข้อมูลพื้นที่"| curate
    aggregateStore -->|"ยอดรายวัน"| curate
    curate -->|"สรุปหลังเชื่อมพื้นที่"| curatedStore
    curatedStore -->|"curated"| quality
    aggregateStore -->|"raw / valid / rejected"| quality
    quality -->|"ผ่านตรวจ"| analysis
    quality -.->|"ไม่ผ่าน"| failed
    analysis --> resultStore
    analysis -->|"ผลวิเคราะห์"| publish
    publish --> successStore
    classDef source fill:#FFFFFF,stroke:#7D8B99,color:#25313B,stroke-width:1.5px
    classDef process fill:#FFFFFF,stroke:#6E879B,color:#294A65,stroke-width:1.5px
    classDef store fill:#FFFFFF,stroke:#7D8B99,color:#25313B,stroke-width:1.5px
    classDef quality fill:#FFFFFF,stroke:#6E879B,color:#294A65,stroke-width:1.5px
    classDef failed fill:#FFFFFF,stroke:#7D8B99,color:#25313B,stroke-width:1.5px
    classDef curated fill:#EEF3F8,stroke:#7D8B99,color:#25313B,stroke-width:1.5px
    class curatedStore curated
