flowchart TD
    %% Generated by scripts/render_pipeline_diagram.py.
    %% Same nodes and data relationships as the approved PNG/SVG.
    %% Stage numbers show execution order; branches show data flow.
    zoneSource["Taxi Zone Lookup<br/>ไฟล์ CSV จาก NYC TLC<br/>ประกอบด้วยรหัสพื้นที่<br/>ชื่อพื้นที่ และ Borough"]:::source
    configSource["Pipeline Config (JSON)<br/>config/pipeline.json<br/>กำหนดช่วงเวลา แหล่งข้อมูล<br/>และตำแหน่งจัดเก็บไฟล์"]:::source
    tripSource["Trip Records<br/>ข้อมูลการเดินทางรูปแบบ Parquet<br/>จาก NYC TLC<br/>รวม 24 ไฟล์ จาก Taxi 4 ประเภท"]:::source
    prepare("01 · PREPARE<br/>อ่านไฟล์ config และช่วงเวลาที่กำหนด<br/>เตรียมรายการไฟล์สำหรับ<br/>การประมวลผล"):::process
    lookup("02 · LOOKUP<br/>โหลดและตรวจสอบข้อมูลพื้นที่จากไฟล์ CSV<br/>ตรวจสอบรหัสพื้นที่ทั้ง 265 รหัสว่าไม่ซ้ำกัน<br/>เก็บข้อมูลไว้ในหน่วยความจำเพื่อใช้งานต่อ"):::process
    trips("03 · TRIPS<br/>ตรวจสอบ SHA-256 โครงสร้างข้อมูล และเงื่อนไขด้านเวลา<br/>สรุปจำนวนเที่ยวรายวัน หรือใช้ผลเดิมจาก cache<br/>หากข้อมูลตรงกัน"):::process
    curate("04 · CURATED<br/>เชื่อมข้อมูลเที่ยวรายวันกับพื้นที่รับผู้โดยสารด้วย LEFT JOIN<br/>เก็บเที่ยวที่ไม่ทราบพื้นที่ไว้ในกลุ่ม Unknown"):::process
    curatedStore[("Curated Parquet<br/>daily_zone_counts.parquet · trip_count<br/>สรุปจำนวนเที่ยวแยกตามวัน ประเภท Taxi พื้นที่ และไฟล์ต้นทาง")]:::data
    quality("05 · QUALITY<br/>ตรวจสอบคุณภาพข้อมูล<br/>ตามเงื่อนไขทั้ง 10 ข้อ<br/>เปรียบเทียบยอดข้อมูลที่สรุปแล้ว<br/>กับผลการตรวจสอบใน audit"):::quality
    analysis("06 · ANALYSIS<br/>สรุปจำนวนเที่ยวและจัดอันดับ Taxi<br/>แต่ละประเภท<br/>สร้างตารางและกราฟ<br/>แสดงผลการวิเคราะห์"):::process
    publish("07 · PUBLISH<br/>บันทึกสถานะ SUCCESS<br/>พร้อม content hash<br/>อัปเดต latest.json ให้ชี้ไปยัง<br/>รอบที่สำเร็จล่าสุด"):::process
    failed("FAILED<br/>บันทึกรายละเอียดข้อผิดพลาดลงใน log<br/>เก็บผลลัพธ์จากรอบที่สำเร็จก่อนหน้าไว้"):::failed
    analysisStore[("Analysis Results<br/>ผลการจัดอันดับ จำนวนเที่ยวรายเดือน<br/>และข้อมูลแยกตามพื้นที่<br/>ผลลัพธ์ในรูปแบบ CSV และกราฟ")]:::data
    runEvidence["Run Logs & Evidence<br/>ไฟล์ run.json และ pipeline.log<br/>latest.json สำหรับอ้างอิง<br/>ผลการรันล่าสุดที่สำเร็จ"]:::evidence
    configSource --> prepare
    zoneSource -->|"ข้อมูลพื้นที่"| lookup
    tripSource -->|"ข้อมูลการเดินทาง"| trips
    prepare -->|"URL ของข้อมูลพื้นที่"| lookup
    prepare -->|"ไฟล์ที่ต้องประมวลผล"| trips
    lookup -->|"ข้อมูลพื้นที่ที่ผ่านการตรวจสอบ"| curate
    trips -->|"จำนวนเที่ยวรายวัน"| curate
    curate -->|"ข้อมูลที่เชื่อมกับพื้นที่แล้ว"| curatedStore
    curatedStore -->|"ข้อมูลที่จัดเตรียมแล้ว"| quality
    trips -->|"Audit: raw / valid / rejected"| quality
    quality -->|"PASS"| analysis
    analysis -->|"ผลการวิเคราะห์"| publish
    quality -.->|"FAIL"| failed
    analysis -->|"ตารางและกราฟ"| analysisStore
    publish -->|"สถานะการรัน"| runEvidence
