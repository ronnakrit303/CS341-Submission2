    configSource --> prepare
    zoneSource -->|"CSV พื้นที่"| lookup
    tripSource -->|"ข้อมูลเที่ยวรถ"| trips
    prepare -->|"URL พื้นที่"| lookup
    prepare -->|"รายการ 24 ไฟล์"| trips
    lookup -->|"lookup ผ่านตรวจ"| zonesStore
    trips -->|"บันทึกผลคำนวณ"| aggregateStore
    aggregateStore -->|"cache ตรงกัน"| trips
    zonesStore -->|"ชื่อพื้นที่"| curate
    aggregateStore -->|"ยอดเที่ยวรายวัน"| curate
    aggregateStore -->|"audit: raw / valid / rejected"| quality
    curate -->|"จำนวนเที่ยวหลัง join"| curatedStore
    curatedStore -->|"curated"| quality
    quality -->|"PASS"| analysis
    quality -.->|"FAIL"| failed
    analysis -->|"รายงาน"| publish
    analysis -->|"ตาราง / กราฟ"| resultStore
    publish -->|"SUCCESS"| successStore
