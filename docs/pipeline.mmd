flowchart TD
    %% Generated by scripts/render_pipeline_diagram.py.
    %% Overview: steps 1–3 share one process; see the README for all seven log stages.
    %% A failed quality gate stops the main flow; other errors also retain the prior success.
    trips["ข้อมูลเที่ยวรถ<br/>Trip Records (Parquet)<br/>24 ไฟล์ จาก Taxi 4 ประเภท"]:::source
    zones["ข้อมูลพื้นที่<br/>Taxi Zone Lookup (CSV)<br/>265 รหัสพื้นที่"]:::source
    prepare("1–3. รับและเตรียมข้อมูล<br/>อ่าน config ตรวจไฟล์และคอลัมน์ที่ต้องใช้<br/>ตรวจพื้นที่และกฎเวลา แล้วสรุปเที่ยวรถรายวัน"):::process
    join("4. เชื่อมข้อมูลพื้นที่<br/>LEFT JOIN ด้วยรหัสพื้นที่รับผู้โดยสาร<br/>เที่ยวที่ไม่ทราบพื้นที่ยังนับรวมเป็น Unknown"):::process
    curated["ชุดข้อมูลพร้อมวิเคราะห์ (Curated)<br/>daily_zone_counts.parquet<br/>สรุปรายวัน × ประเภท Taxi × พื้นที่ × ไฟล์ต้นทาง<br/>จำนวนเที่ยวของแต่ละกลุ่มอยู่ใน trip_count"]:::data
    quality("5. ตรวจคุณภาพ 10 เงื่อนไข<br/>เทียบยอด curated กับ audit<br/>ไม่ผ่าน: บันทึก FAILED และเก็บผลสำเร็จเดิม"):::process
    analysis("6. วิเคราะห์ผล<br/>รวม trip_count เพื่อจัดอันดับและสร้างกราฟ"):::process
    publish("7. บันทึกผลสำเร็จ<br/>บันทึก SUCCESS และอัปเดต latest.json"):::process
    outputs["ผลลัพธ์ที่ตรวจสอบได้<br/>อันดับ / รายเดือน / พื้นที่ / กราฟ<br/>run.json / pipeline.log / content hash"]:::output
    trips --> prepare
    zones --> prepare
    prepare --> join
    join --> curated
    curated --> quality
    quality -->|"ผ่านตรวจ"| analysis
    analysis --> publish
    publish --> outputs
